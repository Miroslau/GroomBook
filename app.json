                  {
                    "path": "./assets/fonts/Source_Sans_3/static/SourceSans3-MediumItalic.ttf",
                    "weight": 500,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Source_Sans_3/static/SourceSans3-Regular.ttf",
                    "weight": 400
                  },
