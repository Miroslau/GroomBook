              "./assets/fonts/Source_Sans_3/static/SourceSans3-BlackItalic.ttf",
              "./assets/fonts/Source_Sans_3/static/SourceSans3-Bold.ttf",
              "./assets/fonts/Source_Sans_3/static/SourceSans3-BoldItalic.ttf",
              "./assets/fonts/Source_Sans_3/static/SourceSans3-ExtraBold.ttf",
              "./assets/fonts/Source_Sans_3/static/SourceSans3-ExtraBoldItalic.ttf",
