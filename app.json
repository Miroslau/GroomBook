{
  "expo": {
    "name": "Groom Book",
    "slug": "grooming-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/groomBookIos.icon",
      "bundleIdentifier": "com.mr-miraslau.groomingapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/groomingAppIcon.png",
        "backgroundImage": "./assets/groomingAppIcon.png",
        "monochromeImage": "./assets/groomingAppIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mr_miraslau.groomingapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Roboto_Slab/RobotoSlab-VariableFont_wght.ttf",
            "./assets/fonts/Source_Sans_3/SourceSans3-Italic-VariableFont_wght.ttf",
